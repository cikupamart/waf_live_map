<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_waf" model="ir.module.category">
            <field name="name">WAF Security</field>
            <field name="sequence">5</field>
        </record>

        <record id="group_waf_viewer" model="res.groups">
            <field name="name">WAF: Viewer (Lihat Log &amp; Dashboard)</field>
            <field name="category_id" ref="module_category_waf"/>
        </record>

        <record id="group_waf_manager" model="res.groups">
            <field name="name">WAF: Administrator (Kelola Konfigurasi)</field>
            <field name="category_id" ref="module_category_waf"/>
            <field name="implied_ids" eval="[(4, ref('group_waf_viewer'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
